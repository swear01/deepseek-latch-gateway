{
  "name": "deepseek-latch-gateway",
  "version": "1.0.0",
  "description": "OpenAI-compatible DeepSeek gateway: ordered per-model provider failover with a 30-minute cooldown.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check-latest": "bun run src/check-latest.ts",
    "build": "bun build --compile --minify --outfile=dist/deepseek-gateway src/index.ts",
    "build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 --outfile=dist/deepseek-gateway-linux-x64 src/index.ts",
    "build:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64-v1.3.13 --outfile=dist/deepseek-gateway-linux-arm64 src/index.ts",
    "build:all": "bun run build && bun run build:linux-x64 && bun run build:linux-arm64"
  },
  "keywords": [
    "deepseek",
    "ai-gateway",
    "opencode-go",
    "llm-proxy",
    "failover"
  ],
  "author": "swear01",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  }
}
